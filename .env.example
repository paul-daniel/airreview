# AirReview model configuration.
# For local use in any reviewed repository, prefer copying the relevant values
# into `<that-repo>/.airreview/.env`. AirReview loads that file automatically,
# so you do not need to run export commands every time.
# Use either FOUNDRY_* or AZURE_AI_* names. Deployment/model must be the deployment name.
# Preferred names for Microsoft Foundry project endpoint and model deployment.
# Endpoint example: https://<resource>.services.ai.azure.com/api/projects/<project>
FOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
# Required by `airreview foundry sync-models`.
FOUNDRY_RESOURCE_GROUP=<resource-group>
FOUNDRY_RESOURCE_NAME=<ai-services-or-foundry-resource-name>
# Runtime fallback model/deployment for direct model mode or SDKs that still require a model argument.
FOUNDRY_MODEL=gpt-5-mini
FOUNDRY_API_KEY=

# Official Azure AI aliases also supported.
AZURE_AI_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
AZURE_AI_FOUNDRY_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5-mini
AZURE_AI_MODEL=gpt-5-mini
AZURE_AI_API_KEY=

# Optional model controls.
# chat = OpenAI-compatible chat.completions with JSON mode.
# responses = OpenAI-compatible responses API.
AIRREVIEW_MODEL_API=chat
AIRREVIEW_MAX_OUTPUT_TOKENS=3000

# Optional: call Foundry Agent Service prompt agents instead of direct model calls.
# Values are agent names created by `airreview foundry sync-agents`.
AIRREVIEW_AGENT_MODE=foundry_agents
AIRREVIEW_FOUNDRY_PLANNING_AGENT=airreview-planning-agent
AIRREVIEW_FOUNDRY_CONTEXT_AGENT=airreview-codebase-context-agent
AIRREVIEW_FOUNDRY_REVIEW_AGENT=airreview-branch-review-agent
AIRREVIEW_FOUNDRY_CRITIC_AGENT=airreview-finding-critic-agent
AIRREVIEW_FOUNDRY_FIX_AGENT=airreview-fix-suggestion-agent

# Optional: override the model deployment used for each Foundry agent invocation.
# Defaults match foundry/models.yaml.
AIRREVIEW_FOUNDRY_PLANNING_MODEL=airreview-planning-mini
AIRREVIEW_FOUNDRY_CONTEXT_MODEL=airreview-context-mini
AIRREVIEW_FOUNDRY_REVIEW_MODEL=airreview-review-codex
AIRREVIEW_FOUNDRY_CRITIC_MODEL=airreview-critic-mini
AIRREVIEW_FOUNDRY_FIX_MODEL=airreview-fix-codex

# Foundry remote MCP tool connection for Context7.
# Create the `context7` project connection in Foundry Tools, then paste its Project connection ID here.
AIRREVIEW_CONTEXT7_CONNECTION_ID=/subscriptions/<subscription-id>/resourceGroups/<resource-group>/providers/Microsoft.CognitiveServices/accounts/<foundry-resource>/projects/<project>/connections/context7

# Optional managed File Search grounding tool.
# Create/upload a managed Foundry File Search index/vector store, then paste the
# vector store id. If this value is missing, agents sync without this grounding tool.
AIRREVIEW_FILE_SEARCH_VECTOR_STORE_ID=vs_<your-vector-store-id>

# GitHub Actions / PR posting
GITHUB_TOKEN=
GITHUB_REPOSITORY=<owner>/<repo>
GITHUB_EVENT_NAME=pull_request
GITHUB_EVENT_PATH=
GITHUB_BASE_REF=main
GITHUB_HEAD_REF=feature/demo

# Azure DevOps pipeline/local posting
SYSTEM_COLLECTIONURI=https://dev.azure.com/<organization>/
SYSTEM_TEAMPROJECT=<project>
BUILD_REPOSITORY_ID=<repository-id-or-name>
SYSTEM_PULLREQUEST_PULLREQUESTID=<pull-request-id>
SYSTEM_PULLREQUEST_SOURCEBRANCH=refs/heads/feature/demo
SYSTEM_PULLREQUEST_TARGETBRANCH=refs/heads/main
SYSTEM_ACCESSTOKEN=
