# AirReview model configuration
# Use either FOUNDRY_* or AZURE_AI_* names. Deployment/model must be the deployment name.
# Preferred names for Microsoft Foundry project endpoint and model deployment.
# Endpoint example: https://<resource>.services.ai.azure.com/api/projects/<project>
FOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
FOUNDRY_MODEL=gpt-5-mini
FOUNDRY_API_KEY=

# Official Azure AI aliases also supported.
AZURE_AI_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
AZURE_AI_FOUNDRY_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5-mini
AZURE_AI_MODEL=gpt-5-mini
AZURE_AI_API_KEY=

# Optional model controls.
# chat = OpenAI-compatible chat.completions with JSON mode.
# responses = OpenAI-compatible responses API.
AIRREVIEW_MODEL_API=chat
AIRREVIEW_MAX_OUTPUT_TOKENS=3000

# Azure DevOps pipeline/local posting
SYSTEM_COLLECTIONURI=https://dev.azure.com/<organization>/
SYSTEM_TEAMPROJECT=<project>
BUILD_REPOSITORY_ID=<repository-id-or-name>
SYSTEM_PULLREQUEST_PULLREQUESTID=<pull-request-id>
SYSTEM_PULLREQUEST_SOURCEBRANCH=refs/heads/feature/demo
SYSTEM_PULLREQUEST_TARGETBRANCH=refs/heads/main
SYSTEM_ACCESSTOKEN=
